{
  "$schema": "vscode://schemas/color-theme",
  "name": "Xcode Inspired Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#292A30",
    "editor.foreground": "#E4E4E8",
    "editor.lineHighlightBackground": "#303139",
    "editor.selectionBackground": "#454652",
    "editor.inactiveSelectionBackground": "#3B3C47",
    "editorCursor.foreground": "#E8E8EC",
    "editorLineNumber.foreground": "#686B76",
    "editorLineNumber.activeForeground": "#B3B5BE",
    "editorIndentGuide.background1": "#393B43",
    "editorIndentGuide.activeBackground1": "#666976",
    "editorWhitespace.foreground": "#494B54",
    "editorGutter.background": "#292A30",
    "editorOverviewRuler.border": "#292A30",
    "sideBar.background": "#25262C",
    "sideBar.foreground": "#D5D5DC",
    "sideBarTitle.foreground": "#E4E4E8",
    "activityBar.background": "#24252B",
    "activityBar.foreground": "#D8D8E0",
    "activityBar.inactiveForeground": "#858792",
    "titleBar.activeBackground": "#25262C",
    "titleBar.activeForeground": "#E4E4E8",
    "statusBar.background": "#25262C",
    "statusBar.foreground": "#D6D6DF",
    "panel.background": "#292A30",
    "terminal.background": "#292A30",
    "terminal.foreground": "#E4E4E8",
    "terminal.ansiMagenta": "#CBA5EA",
    "terminal.ansiBlue": "#9AB9FF",
    "terminal.ansiGreen": "#B8D98B",
    "terminal.ansiYellow": "#E6D07B",
    "terminal.ansiRed": "#FF6DAE",
    "input.background": "#32333C",
    "dropdown.background": "#32333C",
    "list.activeSelectionBackground": "#3D3E4A",
    "list.hoverBackground": "#343540",
    "focusBorder": "#9C82C7"
  },
  "tokenColors": [
    {"scope": ["comment", "punctuation.definition.comment"], "settings": {"foreground": "#828D9A"}},
    {"scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.other", "keyword.declaration"], "settings": {"foreground": "#FF70B4"}},
    {"scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "support.type", "support.class", "storage.type.swift", "entity.name.type.swift"], "settings": {"foreground": "#D1ACEB"}},
    {"scope": ["variable", "variable.other", "variable.parameter", "identifier"], "settings": {"foreground": "#E5E5E9"}},
    {"scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"], "settings": {"foreground": "#E4E4E8"}},
    {"scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": {"foreground": "#FF7665"}},
    {"scope": ["constant.numeric", "constant.language.boolean", "constant.language.nil", "constant.language.null"], "settings": {"foreground": "#E7D47E"}},
    {"scope": ["entity.other.attribute-name", "variable.language", "support.variable", "meta.annotation", "storage.type.annotation"], "settings": {"foreground": "#C9A7E9"}},
    {"scope": ["keyword.operator", "punctuation", "meta.brace"], "settings": {"foreground": "#DFDFE5"}},
    {"scope": ["constant.character.escape", "string.interpolated"], "settings": {"foreground": "#E8BE8D"}}
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "type": "#D1ACEB",
    "class": "#D1ACEB",
    "struct": "#D1ACEB",
    "enum": "#D1ACEB",
    "interface": "#D1ACEB",
    "typeParameter": "#D1ACEB",
    "keyword": "#FF70B4",
    "number": "#E7D47E",
    "string": "#FF7665",
    "comment": "#828D9A",
    "variable": "#E5E5E9",
    "parameter": "#E5E5E9",
    "property": "#E5E5E9",
    "function": "#E4E4E8",
    "method": "#E4E4E8",
    "decorator": "#C9A7E9"
  }
}
